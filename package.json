{
  "name": "art-accessibility-reporting-tool",
  "version": "2.0.0",
  "description": "ART desktop application and web application",
  "main": "desktop/main.cjs",
  "private": true,
  "scripts": {
    "desktop:start": "electron .",
    "desktop:dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "org.art.accessibility-reporting-tool",
    "productName": "ART",
    "files": [
      "index.html",
      "style.css",
      "*.js",
      "*.json",
      "desktop/**/*",
      "docs/**/*",
      "art-help/**/*"
    ],
    "asar": true,
    "win": {
      "target": ["nsis"],
      "artifactName": "ART-Setup-${version}.${ext}",
      "fileAssociations": [
        {
          "ext": "art",
          "name": "ART Project",
          "description": "ART Accessibility Reporting Tool project",
          "role": "Editor"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ART"
    }
  }
}
